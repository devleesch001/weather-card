{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "lib": ["esnext"],
        "esModuleInterop": true,
        "strict": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "skipDefaultLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "outDir": "./dist",
        "strictPropertyInitialization": false,
        "paths": {
            "~/*": ["./src/*"],
            "~~/*": ["./*"]
        }
    },
    "typeRoots": [
        "@types",
        "./node_modules/@types"
    ]
}
